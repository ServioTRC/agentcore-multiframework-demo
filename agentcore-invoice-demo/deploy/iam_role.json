{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "IAM Role for AgentCore Invoice Demo Runtime",
  "Parameters": {
    "AccountId": {
      "Type": "String",
      "Description": "AWS Account ID"
    }
  },
  "Resources": {
    "AgentCoreRuntimeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "AgentCoreRuntimeRole",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "bedrock-agentcore.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "AgentCoreRuntimePolicy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "BedrockModelAccess",
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel",
                    "bedrock:InvokeModelWithResponseStream"
                  ],
                  "Resource": [
                "arn:aws:bedrock:*::foundation-model/*",
                {
                  "Fn::Sub": "arn:aws:bedrock:*:${AccountId}:inference-profile/*"
                }
              ]
                },
                {
                  "Sid": "ECRImagePull",
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage",
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "CloudWatchLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:logs:*:${AccountId}:log-group:/aws/bedrock/agent-runtime/*"
                  }
                },
                {
                  "Sid": "XRayTracing",
                  "Effect": "Allow",
                  "Action": [
                    "xray:PutTraceSegments",
                    "xray:PutTelemetryRecords",
                    "xray:GetSamplingRules",
                    "xray:GetSamplingTargets"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "RoleArn": {
      "Description": "ARN of the AgentCore Runtime Role",
      "Value": { "Fn::GetAtt": ["AgentCoreRuntimeRole", "Arn"] }
    }
  }
}
